{
  "name": "@mokuyoaxis/agent-guard",
  "version": "0.2.5-rc1",
  "description": "Harness-neutral reliability infrastructure for AI coding agents: recoverable destructive actions, disclosure checks, controlled synthetic behaviour experiments, and a shared Core with optional native adapters.",
  "type": "module",
  "main": "./adapters/dsh/lib/index.js",
  "exports": {
    ".": "./adapters/dsh/lib/index.js",
    "./dsh": "./adapters/dsh/lib/index.js",
    "./cordis.patch.yml": "./adapters/dsh/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-guard-doctor": "./doctor.py",
    "agent-guard-live-sentinel": "./live_sentinel.py",
    "agent-guard-lab": "./guard_lab.py",
    "agent-guard-check": "./skills/delete-guard/scripts/check.py",
    "agent-guard-safe-delete": "./skills/delete-guard/scripts/safe_delete.py",
    "agent-guard-restore": "./skills/delete-guard/scripts/restore.py",
    "agent-guard-status": "./skills/delete-guard/scripts/status.py",
    "agent-guard-exfil-check": "./skills/exfil-guard/scripts/check_span.py",
    "agent-guard-exfil-sanitize": "./skills/exfil-guard/scripts/sanitize.py",
    "agent-guard-config-view": "./skills/exfil-guard/scripts/view.py"
  },
  "scripts": {
    "test": "python3 -m unittest discover tests -v && node tests/test_dsh_adapter.mjs && node tests/test_dsh_read_result.mjs",
    "test:dsh": "node tests/test_dsh_adapter.mjs && node tests/test_dsh_read_result.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    "adapters",
    "core",
    "skills",
    "docs",
    "assets",
    "doctor.py",
    "live_sentinel.py",
    "guard_lab.py",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "README.zh-CN.md",
    "!**/__pycache__/**",
    "!**/*.py[cod]"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.1.5-rc.1 || 0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./adapters/dsh/cordis.patch.yml"
    }
  },
  "keywords": [
    "agent-guard", "ai-agents", "coding-agents", "agent-skills",
    "llm-tools", "reliability", "recovery", "destructive-actions",
    "redaction", "quarantine", "audit", "honeytoken",
    "prompt-injection-testing", "git", "safety",
    "deepseek-harness", "dsh", "dsh-plugin", "cordis"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokuyoaxis/agent-guard.git"
  },
  "homepage": "https://github.com/mokuyoaxis/agent-guard#readme",
  "bugs": {
    "url": "https://github.com/mokuyoaxis/agent-guard/issues"
  }
}
